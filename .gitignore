.vs/**/*.slnx
.vs/**/*.slnx.sqlite*
.vs/**/CopilotIndices/
.vs/**/FileContentIndex/
.vs/**/*.wsuo
.vs/**/SemanticSymbols.db*
.vs/**/DocumentLayout*.json
.vs/
/ConsoleApplication1/bin/Debug
/ConsoleApplication1/obj/Debug
